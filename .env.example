# Supabase Postgres connection string — use the Session Pooler connection
# string (Project Settings > Database > Connection string > Session pooler),
# not the direct "db.<ref>.supabase.co" connection: the direct hostname is
# IPv6-only on the free tier and won't resolve on IPv4-only networks. The
# pooler is also what Vercel's serverless functions need in production.
# Username includes the project ref: postgres.<project-ref>
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Random secret used by Payload to sign/encrypt sessions and tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Supabase Storage (S3-compatible) — used for Media uploads, since Vercel's
# serverless functions have no persistent local disk. Get these from the
# Supabase dashboard: Project Settings > Storage > S3 Connection.
# Leave unset locally to fall back to local disk storage during dev.
S3_BUCKET=
S3_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
S3_REGION=YOUR_REGION
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
